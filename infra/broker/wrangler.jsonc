{
  "name": "majord-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // PLACEHOLDER: the Cloudflare account that owns the majord.link zone.
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "workers_dev": false,
  // The zone's root serves only the file that names the phone app (README, "Phone app links").
  "routes": [
    { "pattern": "broker.majord.link", "custom_domain": true },
    { "pattern": "majord.link", "custom_domain": true },
  ],
  // Hourly: reclaim idle addresses. Nightly: bring hosted servers to the latest release.
  "triggers": { "crons": ["17 * * * *", "43 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majord-broker",
      // PLACEHOLDER: the id printed by `wrangler d1 create majord-broker`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // PLACEHOLDER: same account id as above.
    "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    // PLACEHOLDER: the zone id of majord.link.
    "CLOUDFLARE_ZONE_ID": "REPLACE_WITH_CLOUDFLARE_ZONE_ID",
    "ZONE_NAME": "majord.link",
    // PLACEHOLDER: where abuse reports go, shown by GET /.
    "ABUSE_CONTACT": "REPLACE_WITH_ABUSE_CONTACT",
    "MAX_NEW_PER_IP_PER_DAY": "3",
    "MAX_NEW_PER_DAY": "40",
    // A free zone holds 200 DNS records; the rest is headroom.
    "MAX_LIVE_ADDRESSES": "180",
    // Servers Majordome hosts (README, "Hosted servers"). Offered only once FLY_API_TOKEN is set.
    // An organization that holds hosted servers and nothing else (README, "Hosted servers").
    "FLY_ORG_SLUG": "personal",
    // No tag: servers run the digest the latest release names in its image-digest.txt.
    "HOSTED_IMAGE": "ghcr.io/wozacosta/majordome",
    "HOSTED_REGION": "cdg",
    // Each server is billed to the Fly account, so this bounds the bill.
    "MAX_HOSTED_SERVERS": "10",
    // Majordome's account service and the one site allowed to ask for a server from a browser.
    "ACCOUNT_ISSUER": "https://clerk.majord.me",
    "ACCOUNT_PAGE_ORIGIN": "https://majord.me",
    // PLACEHOLDER: the account ids (user_...) that may manage invites at majord.me/admin,
    // comma-separated. Without it that page's routes answer 404.
    "ADMIN_ACCOUNT_IDS": "REPLACE_WITH_ADMIN_ACCOUNT_IDS",
    // Paid servers (README, "Paid servers"). The website sells once the Stripe secrets are set.
    // PLACEHOLDER: the monthly price's id in Stripe.
    "STRIPE_PRICE_ID": "REPLACE_WITH_STRIPE_PRICE_ID",
    "STRIPE_MANAGED_PAYMENTS": "0",
    "TRIAL_DAYS": "7",
    // How long a stopped server and its notes are kept before they are deleted.
    "RETENTION_DAYS": "30",
    // The iPhone app sells once the APPLE_IAP_KEY secret is set.
    // PLACEHOLDER: the In-App Purchase key's id and the issuer id, from App Store Connect.
    "APPLE_IAP_KEY_ID": "REPLACE_WITH_IAP_KEY_ID",
    "APPLE_IAP_ISSUER_ID": "REPLACE_WITH_ISSUER_ID",
    "APPLE_BUNDLE_ID": "io.github.wozacosta.majordome.ios",
    "APPLE_PRODUCT_ID": "io.github.wozacosta.majordome.server.monthly",
    "APPLE_ALLOW_SANDBOX": "0",
  },
  // CLOUDFLARE_API_TOKEN is a secret: `wrangler secret put CLOUDFLARE_API_TOKEN`.
  // FLY_API_TOKEN is a secret too, from `fly tokens create org` for the organization above.
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and APPLE_IAP_KEY are secrets (README, "Paid servers").
  "observability": { "enabled": true },
}
