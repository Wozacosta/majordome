{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git fetch -q --depth=1 origin \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null; git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . || exit 1",
  "redirects": [
    { "source": "/legal", "destination": "/privacy", "permanent": false },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": false },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/server",
      "destination": "/start"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/download/intel",
      "destination": "/api/download?arch=x64"
    }
  ]
}
